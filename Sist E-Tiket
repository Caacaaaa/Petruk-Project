class SistemTopUp{
  int saldo;
public:
  SistemTopUp() : saldo(0){}
  void isiSaldo(int jumlah){
  saldo += jumlah;
  cout << "___________________________" << endl;
  cout << "Saldo berhasil ditambahkan!" << endl;
  cout << "Saldo saat ini: Rp " << saldo << endl;
  cout << "---------------------------" << endl;
  }

  bool bayar(int harga){
    if(saldo >= harga){
        saldo -= harga;
        return true;
  }
    return false;
  }
  int getSaldo() const {return saldo; }
};

